{
  "name": "rivu",
  "version": "1.2.1",
  "description": "A modern and type-safe RSS generator for Node.js.",
  "keywords": [
    "atom",
    "feed",
    "feed builder",
    "rss",
    "rss feed",
    "xml"
  ],
  "homepage": "https://rivu.jarmos.dev",
  "bugs": {
    "url": "https://github.com/Jarmos-san/rivu/issues",
    "email": "contact@jarmos.dev"
  },
  "license": "MIT",
  "author": {
    "name": "Somraj Saha",
    "email": "contact@jarmos.dev",
    "url": "https://jarmos.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jarmos-san/rivu"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/Jarmos-san"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "lint": "eslint .",
    "prepublish": "pnpm build",
    "test": "vitest"
  },
  "dependencies": {
    "xmlbuilder2": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@vitest/coverage-v8": "^4.0.7",
    "eslint": "^9.39.1",
    "oxfmt": "^0.75.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  }
}
